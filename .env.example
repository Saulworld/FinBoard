APP_NAME=本地股票分析与持仓记录
HOST=127.0.0.1
PORT=18010

# 可选：更及时的美股 / ETF 行情
TWELVEDATA_API_KEY=

# 可选：更完整的新闻和分析师观点
FINNHUB_API_KEY=

QUOTE_CACHE_SECONDS=2
DETAIL_CACHE_SECONDS=300
REQUEST_TIMEOUT_SECONDS=12

# 持仓组合汇总统一折算币种（支持 CNY / USD / HKD 等 Yahoo 外汇代码）
PORTFOLIO_BASE_CURRENCY=CNY

# 可选：每日简报项目根目录；留空时尝试发现相邻的“每日简报”目录
BRIEFING_DIR=

# 达人日报：真实 X 动态采集及大模型总结
X_BEARER_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
